@model JoelHiltonFilmCollection.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h2>Edit Movie</h2>

<form method="post">
    <div class="form-group">
        <label>Title</label>
        <input type="text" class="form-control" asp-for="Title" required>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Year</label>
        <input type="number" class="form-control" asp-for="Year" min="1888" required>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input type="checkbox" class="form-check-input" asp-for="Edited">
        <label class="form-check-label">Edited?</label>
    </div>

    <div class="form-group form-check">
        <input type="checkbox" class="form-check-input" asp-for="CopiedToPlex">
        <label class="form-check-label">Copied to Plex?</label>
        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Lent To</label>
        <input type="text" class="form-control" asp-for="LentTo">
    </div>

    <div class="form-group">
        <label>Notes</label>
        <input type="text" class="form-control" asp-for="Notes" maxlength="25">
    </div>

    <button type="submit" class="btn btn-primary mt-2">Edit Movie</button>
</form>

