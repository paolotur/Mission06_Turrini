@model IEnumerable<JoelHiltonFilmCollection.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
}

<h2>Movie Collection</h2>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Title</th>
            <th>Year</th>
            <th>Edited</th>
            <th>Copied to Plex</th>
            <th>Lent To</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Year</td>
                <td>@(movie.Edited ? "Yes" : "No")</td>
                <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                <td>@(string.IsNullOrEmpty(movie.LentTo) ? "N/A" : movie.LentTo)</td>
                <td>@(string.IsNullOrEmpty(movie.Notes) ? "N/A" : movie.Notes)</td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@movie.MovieId">Delete</a>

                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.Message != null)
{
    <p class="alert alert-warning">@ViewBag.Message</p>
}