@model JoelHiltonFilmCollection.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<h2>Add a New Movie</h2>

<form method="post">
    <div class="form-group">
        <label>Category</label>
        <input type="text" class="form-control" asp-for="Category" required>
    </div>

    <div class="form-group">
        <label>Title</label>
        <input type="text" class="form-control" asp-for="Title" required>
    </div>

    <div class="form-group">
        <label>Year</label>
        <input type="text" class="form-control" asp-for="Year" required>
    </div>

    <div class="form-group">
        <label>Director</label>
        <input type="text" class="form-control" asp-for="Director" required>
    </div>

    <div class="form-group">
        <label>Rating</label>
        <select class="form-control" asp-for="Rating" required>
            <option value="">Select a Rating</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>

    <div class="form-group form-check">
        <input type="checkbox" class="form-check-input" asp-for="Edited" />
        <label class="form-check-label">Edited?</label>
    </div>


    <div class="form-group">
        <label>Lent To</label>
        <input type="text" class="form-control" asp-for="LentTo">
    </div>

    <div class="form-group">
        <label>Notes</label>
        <input type="text" class="form-control" asp-for="Notes" maxlength="25">
    </div>

    <button type="submit" class="btn btn-primary mt-2">Add Movie</button>
</form>
